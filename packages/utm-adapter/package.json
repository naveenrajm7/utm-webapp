{
  "name": "@repo/utm-adapter",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**"],
  "scripts": {
    "build": "tsc && mkdir -p dist/scripts && cp src/scripts/*.js dist/scripts/",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest --runInBand"
  },
  "jest": { "preset": "ts-jest", "testEnvironment": "node", "testPathIgnorePatterns": ["/dist/"] },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.5.4"
  }
}
